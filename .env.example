# Copy to .env for docker compose. Every line is optional: appsettings.json and
# the image supply the defaults. The Python's variable names still work, and a
# Section__Key name (e.g. Transcription__Device=Cpu) wins where both are set.
# A blank value means "not set". See docs/STATUS.md, T32 output.

# --- Transcription ---------------------------------------------------------
# base, small, medium, large-v3-turbo ... (GGML weights, fetched into /data/models)
WHISPER_MODEL=base
# Force a language (e.g. en); blank detects it
WHISPER_LANGUAGE=
# Free VRAM after every job so a local LLM can use the card (1, true or yes)
UNLOAD_MODELS_AFTER_JOB=False
# No legacy name: Auto | Cuda | Cpu
# Transcription__Device=Auto

# --- Editing (CLI default; the web form always names a method) -------------
CENSOR_METHOD=silence

# --- Storage ---------------------------------------------------------------
# The image already sets DATA_DIR=/data; override only to move things.
# TRANSCRIPT_DIR=/data/transcripts
# BAD_WORDS_PATH=/data/bad_words.txt
MAX_UPLOAD_MB=4096

# --- Smart Cut (off unless AI_ENHANCE=True) --------------------------------
AI_ENHANCE=False
# local: any OpenAI-compatible server | anything else: Google Gemini
AI_MODE=local
LOCAL_LLM_URL=http://host.docker.internal:8080/v1/chat/completions
LOCAL_LLM_MODEL=
# Secret: set it here or in the host environment, never in appsettings.json
GOOGLE_API_KEY=
