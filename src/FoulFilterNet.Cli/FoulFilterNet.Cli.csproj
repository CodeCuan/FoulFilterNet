<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>foulfilter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- One configuration file for both hosts: Web's, copied beside the
         executable. See the T32 output section of docs/STATUS.md. -->
    <None
      Include="../FoulFilterNet.Web/appsettings.json"
      Link="appsettings.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FoulFilterNet.Domain/FoulFilterNet.Domain.csproj" />
    <ProjectReference Include="../FoulFilterNet.Media/FoulFilterNet.Media.csproj" />
    <ProjectReference Include="../FoulFilterNet.Pipeline/FoulFilterNet.Pipeline.csproj" />
    <ProjectReference Include="../FoulFilterNet.SmartCut/FoulFilterNet.SmartCut.csproj" />
    <ProjectReference Include="../FoulFilterNet.Transcription/FoulFilterNet.Transcription.csproj" />
  </ItemGroup>
</Project>
