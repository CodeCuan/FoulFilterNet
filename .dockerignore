# Only src/ and the three root build files are copied into the image. Keep
# everything else out of the build context - especially weights and secrets.

# Model weights (1.6 GB and up) and runtime data
models/
data/
**/*.bin
**/*.gguf
**/*.ggml

# Secrets: never send an environment file to the daemon
.env
.env.*
**/.env
**/.env.*
**/*.env

# The Python original and its own Docker setup
Legacy/

# Build output
**/bin/
**/obj/
artifacts/
publish/

# Tooling, agent worktrees, VCS
.claude/
.git/
.github/
.vs/
.vscode/
.idea/

# Not needed to build the service
tests/
docs/
